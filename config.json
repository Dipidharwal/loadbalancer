{
  "listen": ":8080",
  "strategy": "round_robin",
  "max_retries": 2,
  "backend_timeout": "30s",
  "health_check_path": "/health",
  "health_check_interval": "5s",
  "health_check_timeout": "2s",
  "backends": [
    { "url": "http://localhost:9001", "weight": 1 },
    { "url": "http://localhost:9002", "weight": 1 },
    { "url": "http://localhost:9003", "weight": 1 }
  ]
}
